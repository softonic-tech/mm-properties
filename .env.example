# Admin
ADMIN_PASSWORD=mmproperty

# Optional storage (Atlas recommended for tokens / visits / leads)
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/mmproperties?retryWrites=true&w=majority
# BLOB_READ_WRITE_TOKEN=

# Meta / Facebook Login
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Public HTTPS origin (ngrok or production). No trailing slash.
BASE_URL=https://your-tunnel.ngrok-free.app
SESSION_SECRET=
# Optional allowlists — leave UNSET/empty so any Meta App Role (Admin/Developer/Tester)
# can connect (recommended, same as SPS). Only set these to lock to specific Facebook user IDs.
# ALLOWED_FACEBOOK_USER_IDS=111,222
# ALLOWED_FACEBOOK_USER_ID=
# Optional: Facebook Login for Business config
META_LOGIN_CONFIG_ID=

# OAuth redirect URI to paste in Meta → Facebook Login → Settings:
# ${BASE_URL}/facebook-callback.html

# Instagram API with Instagram login (separate App ID / Secret from the IG product screen)
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional Instagram allowlist (comma-separated)
# ALLOWED_INSTAGRAM_USER_IDS=
# ALLOWED_INSTAGRAM_USER_ID=
# OAuth redirect URI to paste in Meta → Instagram → API setup with Instagram login:
# ${BASE_URL}/api/instagram-callback
# Deauthorize:   ${BASE_URL}/api/instagram-deauthorize
# Data deletion: ${BASE_URL}/api/instagram-data-deletion
# Permissions: instagram_business_basic, instagram_business_content_publish
# Add the IG account as an Instagram Tester while the app is in Development.

# TikTok Login Kit + Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# ${BASE_URL}/tiktok-callback.html
# TIKTOK_REDIRECT_URI=
# Scopes: user.info.basic, video.upload, video.publish
# Verify URL prefix for photo proxy: ${BASE_URL}/media/tiktok/
# MEDIA_PROXY_SECRET=
# Sandbox: add test users. Enable Direct Post for live posts (else drafts).

# Optional AI captions, and Dutch listing titles missing from the agency feed.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

